<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label tabindex="-1" text="Select Friends" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: upper-center;" />
    <ui:ScrollView name="friendsList" style="flex-grow: 1; max-height: 400px;" />
    <ui:Button text="Invite Friends" parse-escape-sequences="true" display-tooltip-when-elided="true" name="inviteButton" style="margin-top: 16px;" />
</ui:UXML>
